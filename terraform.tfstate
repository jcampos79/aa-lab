            "meta_data": "instance-id: aa-lab-worker-1\nlocal-hostname: aa-lab-worker-1\n",
            "name": "aa-lab-worker-1-cloudinit",
            "network_config": "network:\n  version: 2\n  ethernets:\n    en_iface:\n      match:\n        name: \"en*\"\n      addresses:\n        - 10.0.1.11/24\n      gateway4: 10.0.1.1\n      nameservers:\n        addresses:\n          - 8.8.8.8\n",
            "path": "/tmp/terraform-provider-libvirt-cloudinit/cloudinit-ca0f3b1aabc0a80b.iso",
            "size": 45056,
            "user_data": "#cloud-config\nhostname: aa-lab-worker-1\nmanage_etc_hosts: true\n\nusers:\n  - name: ubuntu\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    lock_passwd: true\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO5+S+AFdALBq6JMTL0gvM0P6S78DR6SD5Ij2mCUbABu jcampos@senzi\n\nssh_pwauth: false\n\n# Grow root partition to fill the disk\ngrowpart:\n  mode: auto\n  devices: [\"/\"]\n\nresize_rootfs: true\n\npackage_update: true\npackage_upgrade: true\npackages:\n  - qemu-guest-agent\n  - curl\n  - apt-transport-https\n  - ca-certificates\n  - gnupg\n\nruncmd:\n  - systemctl enable --now qemu-guest-agent\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        },
